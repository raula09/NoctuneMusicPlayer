<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:MusicPlayerApp.Models"
        xmlns:conv="using:MusicPlayerApp.Converters"
        xmlns:local="using:MusicPlayerApp"
        x:Class="MusicPlayerApp.MainWindow"
        Width="1150"
        Height="720"
        MinWidth="900"
        MinHeight="560"
        Background="#000000"
        DragDrop.AllowDrop="True"
        DragDrop.Drop="FileDrop"
        Title="Music Player">

  <Window.Resources>
    <conv:BooleanToBrushConverter x:Key="FavBrush" />
  </Window.Resources>

  <Window.Styles>

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="Background" Value="#181818"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#282828"/>
    </Style>

    <Style Selector="ToggleButton">
      <Setter Property="Background" Value="#181818"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="ToggleButton:pointerover">
      <Setter Property="Background" Value="#282828"/>
    </Style>

    <Style Selector="ToggleButton:checked">
      <Setter Property="Background" Value="#1DB954"/>
      <Setter Property="Foreground" Value="#000000"/>
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="ListBoxItem:pointerover">
      <Setter Property="Background" Value="#2A2A2A"/>
    </Style>

    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="#333333"/>
    </Style>

  </Window.Styles>

  <Window.DataTemplates>
    <!-- PLAYLIST TRACK ROW -->
    <DataTemplate DataType="models:Track">
        <Border Background="Transparent"
                Padding="4"
                CornerRadius="8">
            <Grid ColumnDefinitions="40,*,200,120,60,40"
                  VerticalAlignment="Center">
                <TextBlock Grid.Column="0"
                           Text="{Binding Index}"
                           Foreground="#B3B3B3"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- Removed the Border for the album cover (Grid.Column="1") -->

                <StackPanel Grid.Column="1"
                            Orientation="Vertical"
                            Spacing="2">
                    <TextBlock Text="{Binding Title}"
                               Foreground="#FFFFFF"
                               FontSize="14"
                               FontWeight="Normal"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Artist}"
                               Foreground="#B3B3B3"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding Album}"
                           Foreground="#A0A0A0"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Column="3"
                           Text="{Binding DateAddedString}"
                           Foreground="#808080"
                           FontSize="12"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="4"
                           Text="{Binding DurationString}"
                           Foreground="#B3B3B3"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>

                <ToggleButton Grid.Column="5"
                              IsChecked="{Binding IsFavorite}"
                              Width="28"
                              Height="28"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              BorderThickness="0"
                              Background="Transparent">
                    <TextBlock Text="♥"
                               FontSize="14"
                               Foreground="{Binding IsFavorite, Converter={StaticResource FavBrush}}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </ToggleButton>

            </Grid>
        </Border>
    </DataTemplate>

    <!-- QUEUE PREVIEW -->
    <DataTemplate DataType="local:QueueEntry">
        <Border Background="Transparent"
                Padding="4,3">
            <Grid ColumnDefinitions="18,40,*"
                  VerticalAlignment="Center">
                <TextBlock Grid.Column="0"
                           Text="▶"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{Binding IsCurrent, Converter={StaticResource FavBrush}}"/>
                <Border Grid.Column="1"
                        Width="36"
                        Height="36"
                        CornerRadius="4"
                        Background="#181818"
                        ClipToBounds="True"
                        Margin="4,0,6,0">
                    <Image Source="{Binding Track.Art}"
                           Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="2"
                            Orientation="Vertical"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <TextBlock Text="{Binding Track.Title}"
                               FontSize="13"
                               FontWeight="Normal"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Track.Artist}"
                               FontSize="11"
                               Foreground="#B3B3B3"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>
</Window.DataTemplates>

  <!-- MAIN ROOT LAYOUT -->
  <Grid>

    <Border Name="BackgroundGradient"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"/>

    <Grid RowDefinitions="*,90"
          ColumnDefinitions="260,*">

  <!-- SIDEBAR -->
<Border Grid.Column="0"
        Grid.RowSpan="2"
        Background="#050505"
        Padding="14">

  <Border Background="#0B0B0B"
          CornerRadius="18"
          Padding="14">

    <ScrollViewer VerticalScrollBarVisibility="Hidden">

      <StackPanel Spacing="22">

        <!-- APP TITLE -->
        <TextBlock Text="Music Player"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#FFFFFF"
                   Margin="2,0,0,0"/>

        <!-- NOW PLAYING MINI -->
        <Border Background="#111111"
                CornerRadius="12"
                Padding="10"
                Margin="0,0,0,2">
          <Grid ColumnDefinitions="48,*,28">

            <Border Width="44"
                    Height="44"
                    CornerRadius="6"
                    Background="#181818"
                    ClipToBounds="True">
              <Image Name="MiniCover"
                     Stretch="UniformToFill"/>
            </Border>

            <StackPanel Grid.Column="1"
                        Orientation="Vertical"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Spacing="2">
              <TextBlock Name="MiniTitle"
                         FontSize="13"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"
                         Foreground="#FFFFFF"/>
              <TextBlock Name="MiniArtist"
                         FontSize="11"
                         Foreground="#B3B3B3"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Button Grid.Column="2"
                    Background="Transparent"
                    Width="26" Height="26"
                    Name="MiniPlayButton">
              <TextBlock Text="▶"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Button>

          </Grid>
        </Border>

        <!-- LIBRARY FILTERS -->
        <StackPanel Spacing="8">

          <TextBlock Text="Your Library"
                     FontSize="12"
                     Foreground="#B3B3B3"
                     Margin="3,0,0,0"/>

          <TextBox Name="SearchBox"
                   Watermark="Search..."
                   CornerRadius="8"
                   Background="#121212"
                   BorderBrush="#222222"
                   BorderThickness="1"
                   Foreground="#FFFFFF"/>

          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <ComboBox Name="SortBox"
                      Width="150"
                      SelectedIndex="0"
                      Background="#121212"
                      BorderBrush="#222222"
                      BorderThickness="1">
              <ComboBoxItem Content="Title (A–Z)" Tag="Title"/>
              <ComboBoxItem Content="Recently Added" Tag="Date"/>
              <ComboBoxItem Content="Artist" Tag="Artist"/>
              <ComboBoxItem Content="Album" Tag="Album"/>
            </ComboBox>

            <ToggleButton Name="FavFilterButton"
                          Content="♥"
                          Width="36"
                          CornerRadius="8"
                          Height="32"
                          FontSize="14"/>
          </StackPanel>

        </StackPanel>

        <!-- ADD / REMOVE -->
        <StackPanel Orientation="Horizontal"
                    Spacing="8">

          <Button Name="AddButton"
                  Background="#1DB954"
                  Foreground="#000000"
                  CornerRadius="18"
                  Padding="12,5">
            <TextBlock Text="Add"/>
          </Button>

          <Button Name="RemoveButton"
                  Background="#181818"
                  Padding="12,5">
            <TextBlock Text="Remove"/>
          </Button>

        </StackPanel>

        <!-- QUEUE -->
        <StackPanel Spacing="6">
          <TextBlock Text="Queue"
                     FontSize="12"
                     Foreground="#B3B3B3"
                     Margin="3,0,0,0"/>

          <Border Background="#0F0F0F"
        CornerRadius="14"
        Padding="4"
        MaxHeight="800">

            <ScrollViewer VerticalScrollBarVisibility="Hidden">
              <ItemsControl Name="QueueItemsControl">
                <ItemsControl.Styles>
                  <Style Selector="ContentPresenter">
                    <Setter Property="Margin" Value="0,2"/>
                  </Style>
                </ItemsControl.Styles>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </StackPanel>

      </StackPanel>

    </ScrollViewer>
  </Border>
</Border>

      <!-- MAIN CONTENT -->
      <Grid Grid.Column="1"
            Grid.Row="0"
            Margin="10,10,16,4">

        <Grid RowDefinitions="Auto,*">

          <!-- NOW PLAYING AREA -->
          <Grid Grid.Row="0"
                ColumnDefinitions="Auto,*"
                Margin="0,0,0,16"
                VerticalAlignment="Top">

            <Border Width="180"
                    Height="180"
                    Background="#181818"
                    CornerRadius="16"
                    Padding="10">
              <Border CornerRadius="12"
                      ClipToBounds="True"
                      Background="#000000">
                <Image Name="AlbumArt"
                       Stretch="UniformToFill"/>
              </Border>
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="18,4,0,0"
                        VerticalAlignment="Center"
                        Spacing="4">
              <TextBlock Text="Now Playing"
                         FontSize="12"
                         Foreground="#B3B3B3"/>
              <TextBlock Name="TrackLabel"
                         FontSize="24"
                         TextWrapping="Wrap"
                         Foreground="#FFFFFF"/>
              <TextBlock Name="ArtistLabel"
                         FontSize="15"
                         Foreground="#C6C6C6"
                         TextWrapping="Wrap"/>
              <TextBlock Name="AlbumLabel"
                         FontSize="13"
                         Foreground="#9B9B9B"
                         TextWrapping="Wrap"/>
            </StackPanel>

          </Grid>

          <!-- PLAYLIST -->
          <Border Grid.Row="1"
                  Background="#181818"
                  CornerRadius="12"
                  Padding="4"
                  Margin="0,0,0,4">
            <ListBox Name="PlaylistBox"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Play" x:Name="PlayContextMenuItem"/>
                  <MenuItem Header="Remove" x:Name="RemoveContextMenuItem"/>
                  <MenuItem Header="Open Containing Folder" x:Name="OpenFolderContextMenuItem"/>
                </ContextMenu>
              </ListBox.ContextMenu>
            </ListBox>
          </Border>

        </Grid>

      </Grid>

      <!-- PLAYER BAR -->
      <Border Grid.ColumnSpan="2"
              Grid.Row="1"
              Background="#000000"
              Padding="12,6,16,6">

        <Grid RowDefinitions="*,*,*,*"
              ColumnDefinitions="*,Auto,*"
              VerticalAlignment="Center">

          <!-- TIME SLIDER -->
          <Grid Grid.Row="0"
                Grid.Column="0"
                ColumnDefinitions="Auto,*,Auto"
                Margin="0,0,0,4"
                VerticalAlignment="Center">

            <TextBlock Grid.Column="0"
                       Name="CurrentTimeText"
                       Foreground="#B3B3B3"
                       FontSize="11"
                       Margin="0,0,6,0"/>
            <Slider Grid.Column="1"
        Name="PositionSlider"
        Minimum="0"
        Maximum="100"
        Height="16"
        VerticalAlignment="Center">
    <Slider.Styles>
     
        <Style Selector="Slider /template/ Track /template/ Rectangle#PART_Track">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Fill" Value="#2a2a2a"/>
        </Style>

     
        <Style Selector="Slider /template/ Track /template/ Rectangle#PART_Indicator">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Fill" Value="#1DB954"/>
        </Style>

       
        <Style Selector="Slider /template/ Thumb">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Background" Value="#1DB954"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>
    </Slider.Styles>
</Slider>

            <TextBlock Grid.Column="2"
                       Name="TotalTimeText"
                       Foreground="#B3B3B3"
                       FontSize="11"
                       Margin="6,0,0,0"/>
          </Grid>

          <!-- CONTROLS -->
          <StackPanel Grid.Row="1"
                      Grid.Column="1"
                      Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="18">
            <ToggleButton Name="ShuffleButton"
                          Width="32" Height="32"
                          CornerRadius="16"
                          Content="⤭"
                          FontSize="14"
                          Background="Transparent"/>
            <Button Name="PrevButton"
                    Width="32" Height="32"
                    Background="Transparent">
              <TextBlock Text="⏮"
                         FontSize="16"
                         Foreground="#FFFFFF"/>
            </Button>
            <Border Width="60" Height="60"
                    CornerRadius="30"
                    Background="#181818">
              <Button Name="PlayPauseButton"
                      Background="#1DB954"
                      Foreground="#000000"
                      BorderThickness="0"
                      CornerRadius="30"
                      Width="60" Height="60">
                <TextBlock Name="PlayPauseIcon"
                           Text="▶"
                           FontSize="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </Button>
            </Border>
            <Button Name="NextButton"
                    Width="32" Height="32"
                    Background="Transparent">
              <TextBlock Text="⏭"
                         FontSize="16"
                         Foreground="#FFFFFF"/>
            </Button>
            <ToggleButton Name="LoopButton"
                          Width="32"
                          Height="32"
                          CornerRadius="16"
                          Content="⟳"
                          FontSize="14"
                          Background="Transparent"/>
          </StackPanel>

          <!-- VOLUME & VISUALIZER -->
          <StackPanel Grid.Row="1"
                      Grid.Column="2"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Spacing="10">

            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Vol"
                         Foreground="#C0C0C0"
                         FontSize="12"/>
              <Slider Name="VolumeSlider"
                      Minimum="0"
                      Maximum="100"
                      Width="130"/>
            </StackPanel>

            <Border Width="80" Height="26"
                    Background="#181818"
                    CornerRadius="13"
                    Padding="4">
              <StackPanel Name="VisualizerPanel"
                          Orientation="Horizontal"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Spacing="2"/>
            </Border>

          </StackPanel>

        </Grid>

      </Border>

    </Grid>

  </Grid>

</Window>