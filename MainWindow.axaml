<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:MusicPlayerApp.Models"
             xmlns:conv="using:MusicPlayerApp.Converters"
             xmlns:local="using:MusicPlayerApp"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
             x:Class="MusicPlayerApp.MainWindow"
             Background="#000000"
             DragDrop.AllowDrop="True"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             MinWidth="900"
             MinHeight="600">

  <UserControl.Resources>
    <conv:BooleanToBrushConverter x:Key="FavBrush" />
    <DataTemplate x:Key="WaveAnimationTemplate">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Border Width="3" Height="8" Background="#1DB954" CornerRadius="2"/>
        <Border Width="3" Height="12" Background="#1DB954" CornerRadius="2"/>
        <Border Width="3" Height="6" Background="#1DB954" CornerRadius="2"/>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="Background" Value="#282828"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Focusable" Value="False"/>
    </Style>

    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#3E3E3E"/>
    </Style>

    <Style Selector="ToggleButton">
      <Setter Property="Background" Value="#282828"/>
      <Setter Property="Foreground" Value="#B3B3B3"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Focusable" Value="False"/>
    </Style>

    <Style Selector="ToggleButton:pointerover">
      <Setter Property="Background" Value="#3E3E3E"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style Selector="ToggleButton:checked">
      <Setter Property="Background" Value="#1DB954"/>
      <Setter Property="Foreground" Value="#000000"/>
    </Style>

    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Focusable" Value="False"/>
    </Style>
    
    <Style Selector="Button.icon:pointerover">
      <Setter Property="Background" Value="#282828"/>
    </Style>

    <Style Selector="Button.icon Image, ToggleButton Image">
      <Setter Property="Opacity" Value="0.7"/>
    </Style>

    <Style Selector="Button.icon:pointerover Image, ToggleButton:pointerover Image">
      <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="ToggleButton:checked Image">
      <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>

    <Style Selector="ListBoxItem:pointerover">
      <Setter Property="Background" Value="#1A1A1A"/>
    </Style>

    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ListBoxItem:selected:pointerover">
      <Setter Property="Background" Value="#1A1A1A"/>
    </Style>

    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1A1A1A"/>
    </Style>

    <Style Selector="ListBoxItem:focus">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>

  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate DataType="models:Track">
      <Border Background="Transparent"
              Padding="0,6"
              CornerRadius="6">
        <Grid ColumnDefinitions="40,40,*,220,130,60">
          <Grid Grid.Column="0">
            <TextBlock Name="TrackIndexText"
                       Text="{Binding Index}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#9E9E9E"
                       FontSize="14"/>

            <ContentControl Name="WaveIcon"
                            Content="{StaticResource WaveAnimationTemplate}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="False"/>
          </Grid>

          <Border Grid.Column="1"
                  Width="38"
                  Height="38"
                  CornerRadius="4"
                  ClipToBounds="True"
                  Background="#181818">
            <Image Source="{Binding Art}" Stretch="UniformToFill"/>
          </Border>

          <StackPanel Grid.Column="2"
                      Orientation="Vertical"
                      Spacing="2"
                      VerticalAlignment="Center"
                      Margin="12,0,0,0">
            <TextBlock Text="{Binding Title}"
                       FontSize="14"
                       Foreground="White"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Artist}"
                       FontSize="12"
                       Foreground="#B3B3B3"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>

          <TextBlock Grid.Column="3"
                     Text="{Binding Album}"
                     Foreground="#B3B3B3"
                     FontSize="13"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"/>

          <TextBlock Grid.Column="4"
                     Text="{Binding DateAddedString}"
                     Foreground="#A7A7A7"
                     FontSize="13"
                     VerticalAlignment="Center"/>

          <TextBlock Grid.Column="5"
                     Text="{Binding DurationString}"
                     Foreground="#B3B3B3"
                     FontSize="13"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"/>
        </Grid>

        <Border.Styles>
          <Style Selector="Border:pointerover">
            <Setter Property="Background" Value="#1A1A1A"/>
          </Style>
        </Border.Styles>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="local:QueueEntry">
      <Border Padding="4,3">
        <Border.Styles>
          <Style Selector="Border">
            <Setter Property="Background" Value="Transparent"/>
          </Style>
          <Style Selector="Border:pointerover">
            <Setter Property="Background" Value="#1A1A1A"/>
          </Style>
          <Style Selector="Border[Tag=Current]">
            <Setter Property="Background" Value="#222222"/>
          </Style>
        </Border.Styles>

        <Grid ColumnDefinitions="18,40,12,*">
          <TextBlock Grid.Column="0"
                     FontSize="12"
                     HorizontalAlignment="Center"
                     Foreground="{Binding IsCurrent, Converter={StaticResource FavBrush}}"/>
          <Border Grid.Column="1"
                  Width="36"
                  Height="36"
                  CornerRadius="4"
                  ClipToBounds="True"
                  Background="#181818">
            <Image Source="{Binding Track.Art}" Stretch="UniformToFill"/>
          </Border>
          <StackPanel Grid.Column="3" Spacing="2">
            <TextBlock Text="{Binding Track.Title}"
                       FontSize="13"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Track.Artist}"
                       FontSize="11"
                       Foreground="#B3B3B3"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid>
    <Border Name="BackgroundGradient"/>

    <Grid Name="MainContentGrid" RowDefinitions="*,Auto" ColumnDefinitions="Auto,*,380">

      <Border Grid.Column="0" Grid.RowSpan="2" Background="#000000" Padding="8" MinWidth="240" MaxWidth="320">
        <Border Background="#0A0A0A" CornerRadius="12" Padding="0">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Padding="16,20">
            <StackPanel Spacing="24">
              <StackPanel Spacing="4">
                <TextBlock Text="NOCTUNE"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#1DB954"
                           LetterSpacing="2"
                           Margin="0,0,0,2"/>
                <Border Height="2"
                        Background="#1DB954"
                        CornerRadius="1"
                        Width="60"
                        HorizontalAlignment="Left"
                        Opacity="0.8"/>
              </StackPanel>

              <Border Background="#151515"
                      CornerRadius="10"
                      Padding="12" 
                      BorderBrush="#252525"
                      BorderThickness="1">
                <Grid ColumnDefinitions="52,*,32">
                  <Border Width="48"
                          Height="48"
                          CornerRadius="8"
                          Background="#1A1A1A"
                          ClipToBounds="True"
                          BoxShadow="0 4 12 0 #000000">
                    <Image Name="MiniCover" Stretch="UniformToFill"/>
                  </Border>
                  <StackPanel Grid.Column="1"
                              Margin="12,0,8,0"
                              VerticalAlignment="Center"
                              Spacing="3">
                    <TextBlock Name="MiniTitle"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Name="MiniArtist"
                               FontSize="11"
                               Foreground="#9A9A9A"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Button Grid.Column="2"
                          Background="#1DB954"
                          Width="30"
                          Height="30"
                          CornerRadius="15"
                          Padding="0"
                          Name="MiniPlayButton">
                    <Path Fill="#000000"
                          Data="M8 5v14l11-7z"
                          Stretch="Uniform"
                          Width="10"
                          Height="10"
                          Margin="2,0,0,0"/>
                  </Button>
                </Grid>
              </Border>

              <StackPanel Spacing="6">
                <TextBlock Text="NAVIGATION"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#666666"
                           LetterSpacing="1"
                           Margin="4,0,0,6"/>
                
                <Button Name="OpenPlaylistsButton">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Background="#1DB954" Width="32" Height="32" CornerRadius="6" Padding="7">
                      <Path Fill="#ffffffff"
                            Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                            Stretch="Uniform"
                            Width="18" 
                            Height="18"/>
                    </Border>
                    <TextBlock Text="Your Playlists"
                               FontSize="14"
                               FontWeight="Medium"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </StackPanel>

              <StackPanel Spacing="10">
                <TextBlock Text="YOUR LIBRARY"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#666666"
                           LetterSpacing="1"
                           Margin="4,0,0,4"/>

                <Grid ColumnDefinitions="*,Auto">
                  <ComboBox Name="SortBox"
                            Grid.Column="0"
                            SelectedIndex="0"
                            Background="#151515"
                            BorderBrush="#2A2A2A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6"
                            FontSize="12">
                    <ComboBoxItem Content="Title (A–Z)" Tag="Title"/>
                    <ComboBoxItem Content="Recently Added" Tag="Date"/>
                    <ComboBoxItem Content="Artist" Tag="Artist"/>
                    <ComboBoxItem Content="Album" Tag="Album"/>
                  </ComboBox>
                </Grid>
              </StackPanel>

              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="NEXT IN QUEUE"
                             FontSize="10"
                             FontWeight="Bold"
                             Foreground="#666666"
                             LetterSpacing="1"
                             VerticalAlignment="Center"/>
                  <Border Background="#1DB954" 
                          CornerRadius="8" 
                          Padding="4,2">
                    <TextBlock Text="LIVE"
                               FontSize="8"
                               FontWeight="Bold"
                               Foreground="#000000"/>
                  </Border>
                </StackPanel>
                
                <Border Background="#0F0F0F"
                        CornerRadius="10"
                        Padding="6"
                        BorderBrush="#1F1F1F"
                        BorderThickness="1">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl Name="QueueItemsControl"
                                  PointerPressed="QueueItem_PointerPressed">
                      <ItemsControl.Styles>
                        <Style Selector="ContentPresenter">
                          <Setter Property="Margin" Value="0,1"/>
                        </Style>
                      </ItemsControl.Styles>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Border>

      <Grid Grid.Column="1" Grid.Row="0" Margin="16">
        <Grid RowDefinitions="Auto,Auto,*">
          <TextBox
            Grid.Row="0"
            Name="SearchBox"
            HorizontalAlignment="Center"
            Watermark="Search tracks..."
            Height="46"
            Width="350"
            CornerRadius="12"
            Background="#111111"
            BorderBrush="#2A2A2A"
            BorderThickness="1.4"
            Padding="16,12"
            FontSize="15"
            VerticalAlignment="Top"
            Margin="0,0,0,24"/>

          <Grid Grid.Row="1"
                Margin="0,0,0,24"
                ColumnDefinitions="Auto,*,Auto">

            <Grid Grid.Column="0"
                  Width="260"
                  Height="260"
                  Name="MiniCoverContainer">
              <Border CornerRadius="18"
                      ClipToBounds="True"
                      Background="#181818">
                <Image Name="AlbumArt"
                       Stretch="UniformToFill"/>
              </Border>

              <StackPanel Name="MiniHoverControls"
                          Orientation="Horizontal"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Spacing="18"
                          Opacity="0"
                          IsHitTestVisible="False">

                <Button Name="MiniPrev"
                        Width="42" Height="42"
                        Background="#121212DD"
                        CornerRadius="21">
                  <Path Fill="White"
                        Data="M11 18V6l-8.5 6 8.5 6zm.5-6l8.5 6V6l-8.5 6z"/>
                </Button>

                <Button Name="MiniPlayPause"
                        Width="56" Height="56"
                        Background="#1DB954"
                        CornerRadius="28">
                  <Path Fill="Black"
                        Data="M8 5v14l11-7z"/>
                </Button>

                <Button Name="MiniNext"
                        Width="42" Height="42"
                        Background="#121212DD"
                        CornerRadius="21">
                  <Path Fill="White"
                        Data="M4 18l8.5-6L4 6v12zm9-12v12l8.5-6L13 6z"/>
                </Button>
              </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1"
                        Margin="40,0,0,0"
                        VerticalAlignment="Center"
                        Spacing="14">
              <TextBlock Text="Now Playing"
                         FontSize="13"
                         Foreground="#B3B3B3"/>

              <TextBlock Name="TrackLabel"
                         FontSize="34"
                         FontWeight="Bold"
                         TextWrapping="Wrap"/>

              <TextBlock Name="ArtistLabel"
                         FontSize="18"
                         Foreground="#C6C6C6"/>

              <TextBlock Name="AlbumLabel"
                         FontSize="14"
                         Foreground="#9B9B9B"/>
            </StackPanel>
          </Grid>

          <Border Grid.Row="2"
                  Background="#181818"
                  CornerRadius="12"
                  Padding="8">
            <ListBox Name="PlaylistBox"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Play" Name="PlayContextMenuItem"/>
                  <MenuItem Header="📝 Upload Lyrics" Name="UploadLyricsMenuItem"/>
                  <MenuItem Header="Remove" Name="RemoveContextMenuItem"/>
                  <MenuItem Header="Add to Playlist" Name="AddToPlaylistMenuItem"/>
                  <MenuItem Header="Open Containing Folder" Name="OpenFolderContextMenuItem"/>
                </ContextMenu>
              </ListBox.ContextMenu>
            </ListBox>
          </Border>
        </Grid>
      </Grid>

      <Border Name="LyricsPanelContainer"
              Grid.Column="2"
              Grid.Row="0"
              Background="#0A0A0A"
              Margin="0,16,16,0"
              CornerRadius="12"
              IsVisible="True">
        <local:LyricsDisplay Name="LyricsDisplay"/>
      </Border>

      <Border Grid.Column="0"
              Grid.ColumnSpan="3"
              Grid.Row="1"
              Background="#000000"
              Padding="20,12">
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,*">
          <Grid Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                ColumnDefinitions="Auto,*,Auto"
                Margin="0,0,0,16">
            <TextBlock Grid.Column="0"
                       Name="CurrentTimeText"
                       Text="0:00"
                       Foreground="#B3B3B3"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <Border Grid.Column="1"
                    x:Name="SeekBarContainer"
                    Height="8"
                    Background="#4A4A4A"
                    CornerRadius="4"
                    VerticalAlignment="Center"
                    PointerPressed="SeekBarPressed"
                    PointerMoved="SeekBarMoved"
                    PointerReleased="SeekBarReleased"
                    PointerCaptureLost="SeekBarCaptureLost">
              <Border x:Name="SeekBarFill"
                      Background="#1DB954"
                      HorizontalAlignment="Left"
                      CornerRadius="4"
                      Width="0"/>
            </Border>

            <TextBlock Grid.Column="2"
                       Name="TotalTimeText"
                       Text="0:00"
                       Foreground="#B3B3B3"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
          </Grid>

          <StackPanel Grid.Row="1" Grid.Column="0"/>

          <StackPanel Grid.Row="1"
                      Grid.Column="1"
                      Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      Spacing="10">
            <Button Name="FullscreenButton"
                    Classes="icon"
                    Width="38"
                    Height="38">
              <Path Fill="#B3B3B3"
                    Data="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"
                    Stretch="Uniform"
                    Width="18"
                    Height="18"/>
            </Button>
            
            <Button Name="LyricsToggleButton"
                    Width="40"
                    Height="36"
                    Background="#282828"
                    CornerRadius="4"
                    Margin="8,0"
                    ToolTip.Tip="Toggle Lyrics"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
              <TextBlock Text="♪"
                         FontSize="20"
                         Foreground="#1DB954"
                         FontWeight="Bold"/>
            </Button>

            <ToggleButton Name="ShuffleButton"
                          Classes="icon"
                          Width="38"
                          Height="38">
              <Path Fill="#B3B3B3"
                    Data="M10.59 9.17L5.41 4 4 5.41l5.17 5.17 1.42-1.41zM14.5 4l2.04 2.04L4 18.59 5.41 20 17.96 7.46 20 9.5V4h-5.5zm.33 9.41l-1.41 1.41 3.13 3.13L14.5 20H20v-5.5l-2.04 2.04-3.13-3.13z"
                    Stretch="Uniform"
                    Width="18"
                    Height="18"/>
            </ToggleButton>
            
            <Button Name="PrevButton"
                    Classes="icon"
                    Width="38"
                    Height="38">
              <Path Fill="#B3B3B3"
                    Data="M11 18V6l-8.5 6 8.5 6zm.5-6l8.5 6V6l-8.5 6z"
                    Stretch="Uniform"
                    Width="20"
                    Height="20"/>
            </Button>
            
            <Button Name="PlayPauseButton"
                    Background="#1DB954"
                    BorderThickness="0"
                    CornerRadius="26"
                    Width="52"
                    Height="52"
                    Padding="0">
              <Image Name="PlayPauseIcon"
                     Width="22"
                     Height="22"/>
            </Button>
            
            <Button Name="NextButton"
                    Classes="icon"
                    Width="38"
                    Height="38">
              <Path Fill="#B3B3B3"
                    Data="M4 18l8.5-6L4 6v12zm9-12v12l8.5-6L13 6z"
                    Stretch="Uniform"
                    Width="20"
                    Height="20"/>
            </Button>
            
            <ToggleButton Name="LoopButton"
                          Classes="icon"
                          Width="38"
                          Height="38">
              <Path Fill="#B3B3B3"
                    Data="M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4z"
                    Stretch="Uniform"
                    Width="18"
                    Height="18"/>
            </ToggleButton>
          </StackPanel>

          <StackPanel Grid.Row="1"
                      Grid.Column="2"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="12">
            <TextBlock Text="Vol"
                       Foreground="#B3B3B3"
                       FontSize="11"
                       VerticalAlignment="Center"/>
            <Slider Name="VolumeSlider"
                    Minimum="0"
                    Maximum="100"
                    Value="50"
                    Width="100"
                    VerticalAlignment="Center">
              <Slider.Styles>
                <Style Selector="Slider /template/ Track /template/ Rectangle#PART_Track">
                  <Setter Property="Height" Value="3"/>
                  <Setter Property="Fill" Value="#4A4A4A"/>
                </Style>
                <Style Selector="Slider /template/ Track /template/ Rectangle#PART_Indicator">
                  <Setter Property="Height" Value="3"/>
                  <Setter Property="Fill" Value="#FFFFFF"/>
                </Style>
                <Style Selector="Slider /template/ Thumb">
                  <Setter Property="Width" Value="10"/>
                  <Setter Property="Height" Value="10"/>
                  <Setter Property="Background" Value="#FFFFFF"/>
                  <Setter Property="CornerRadius" Value="5"/>
                  <Setter Property="Opacity" Value="0"/>
                </Style>
                <Style Selector="Slider:pointerover /template/ Thumb">
                  <Setter Property="Opacity" Value="1"/>
                </Style>
              </Slider.Styles>
            </Slider>
            <Border Width="120"
                    Height="24"
                    Background="#0a0a0a"
                    CornerRadius="12"
                    Padding="6,4">
              <StackPanel Name="VisualizerPanel"
                          Orientation="Horizontal"
                          HorizontalAlignment="Center"
                          Spacing="1"/>
            </Border>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Name="MainForceCreateOverlay"
            Background="#000000AA"
            IsVisible="False"
            ZIndex="999"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <Border Width="420"
              Background="#121212"
              CornerRadius="16"
              Padding="24"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="Create Your First Playlist"
                     FontSize="24"
                     FontWeight="Bold"
                     HorizontalAlignment="Center"/>

          <TextBlock Text="You need at least one playlist to use Noctune fully."
                     Foreground="#B3B3B3"
                     FontSize="13"
                     HorizontalAlignment="Center"/>

          <TextBox Name="MainForceNameBox"
                   Watermark="Playlist name"
                   Background="#282828"
                   Foreground="#FFFFFF"
                   BorderBrush="#535353"
                   CornerRadius="6"
                   Padding="8"/>

          <TextBox Name="MainForceDescBox"
                   Watermark="Description (optional)"
                   Background="#282828"
                   Foreground="#FFFFFF"
                   BorderBrush="#535353"
                   CornerRadius="6"
                   Padding="8"/>

          <Button Name="MainForceCreateButton"
                  Background="#1DB954"
                  Foreground="#000000"
                  Padding="12"
                  CornerRadius="8"
                  FontSize="14"
                  HorizontalAlignment="Stretch">
            Create Playlist
          </Button>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>